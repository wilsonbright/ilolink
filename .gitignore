# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Env / secrets
.env
.env.*
!.env.example

# Env / secrets (Cloudflare local dev vars)
.dev.vars
.dev.vars.*
# ...but the template carries no real values and must be committed, or a fresh
# checkout has no record of which secrets the workers need. Mirrors !.env.example.
!.dev.vars.example

# Deps / build
node_modules/
dist/
build/

# Next.js
.next/
next-env.d.ts

# OpenNext + Cloudflare
.open-next/
.wrangler/
cloudflare-env.d.ts

# Cloudflare deploy creds (never commit)
.cf.env

# TS incremental build cache
*.tsbuildinfo

# Test artifacts
.playwright-mcp/
*.png

# ...but Next's metadata images are source, not screenshots. Without these two
# lines they are ignored by the blanket *.png above, so they work on the machine
# that made them and are simply absent from a clean checkout — the deploy then
# serves no og:image and no apple-touch-icon, with nothing failing anywhere.
!app/opengraph-image.png
!app/apple-icon.png

# Public build vars only (NEXT_PUBLIC_*) — never real secrets
!.env.production

# Linked git worktrees, kept inside the project because this project's rules say
# work never leaves this folder. A worktree holds a full checkout, so leaving it
# unignored would commit the tree into itself. (Deploy scratch dirs like
# .deploy-tmp are the same shape and are covered by the same reasoning.)
.worktrees/
.deploy-tmp/
